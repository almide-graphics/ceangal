// ceangal v2 — UI framework for Almide
//
// The browser host's entry: the wasm exports host/runtime.js calls. Each one
// hands off to the shared runtime in app.almd, which the native host
// (examples/native) drives directly. Only what exists for the browser lives
// here — the DOM string handoff behind `get_item_text`.

import self.dom as dom
import self.app as app
// Not referenced here, but the wasm renderer needs the modules declaring the
// types that reach this entry (View, Node) imported by it.
import self.view as _view
import self.layout as _layout

// ══════════════════════════════════════════════════════════════
// Mouse effects (fragment-only, no compute re-run)
// ══════════════════════════════════════════════════════════════

@export(wasm, "set_mouse")
fn set_mouse(css_x: Float, css_y: Float) -> Unit = app.set_mouse(css_x, css_y)

@export(wasm, "draw_light")
fn draw_light() -> Unit = app.draw_light()

@export(wasm, "set_hover")
fn set_hover(item_idx: Float) -> Unit = app.set_hover(item_idx)

// ══════════════════════════════════════════════════════════════
// Scene lifecycle
// ══════════════════════════════════════════════════════════════

@export(wasm, "prepare_scene")
fn do_prepare(device: Int, css_w: Int, css_h: Int, phys_w: Int, phys_h: Int,
              img_vtx: Int, img_idx: Int, img_count: Int, img_texture: Int, img_sampler: Int,
              bg_texture: Int, bg_sampler: Int) -> Unit =
  app.prepare(device, css_w, css_h, phys_w, phys_h,
    img_vtx, img_idx, img_count, img_texture, img_sampler, bg_texture, bg_sampler)

// ══════════════════════════════════════════════════════════════
// Scroll (hot path — physics only)
// ══════════════════════════════════════════════════════════════

@export(wasm, "scroll_tick")
fn scroll_tick(dt: Float) -> Int = app.scroll_tick(dt)

@export(wasm, "scroll_wheel")
fn scroll_wheel(region: Int, dx: Float, dy: Float) -> Unit = app.scroll_wheel(region, dx, dy)

@export(wasm, "get_scroll_pos")
fn get_scroll_pos(region: Int, axis: Int) -> Float = app.get_scroll_pos(region, axis)

@export(wasm, "flush")
fn flush() -> Unit = app.flush()

@export(wasm, "set_scroll_frac")
fn set_scroll_frac(frac: Float) -> Unit = app.set_scroll_frac(frac)

@export(wasm, "get_scroll_info")
fn get_scroll_info() -> Float = app.get_scroll_info()

// ══════════════════════════════════════════════════════════════
// Test helpers
// ══════════════════════════════════════════════════════════════

@export(wasm, "set_viewport")
fn set_viewport(w: Float, h: Float) -> Unit = app.set_viewport(w, h)

// ══════════════════════════════════════════════════════════════
// Text field input (JS writes UTF-8 bytes, then submits)
// ══════════════════════════════════════════════════════════════

@export(wasm, "input_clear")
fn input_clear() -> Unit = app.input_clear()

@export(wasm, "input_push")
fn input_push(byte: Int) -> Unit = app.input_push(byte)

@export(wasm, "input_submit")
fn input_submit() -> Unit = app.input_submit()

// ══════════════════════════════════════════════════════════════
// State change (triggers rebuild)
// ══════════════════════════════════════════════════════════════

@export(wasm, "todo_init_data")
fn todo_init_data() -> Unit = app.todo_init_data()

@export(wasm, "todo_add")
fn todo_add() -> Unit = app.todo_add()

@export(wasm, "todo_toggle")
fn todo_toggle(id: Int) -> Unit = app.todo_toggle(id)

// ══════════════════════════════════════════════════════════════
// Item accessors (for the DOM overlay)
// ══════════════════════════════════════════════════════════════

fn s(text: String) -> Int = {
  dom.begin_str()
  for b in string.to_bytes(text) { dom.push_byte(b) }
  dom.commit_str()
}

@export(wasm, "get_item_count")
fn get_item_count() -> Int = list.len(app.cached_items)

@export(wasm, "get_item_x")
fn get_item_x(i: Int) -> Float = app.cached_items[i].x

@export(wasm, "get_item_y")
fn get_item_y(i: Int) -> Float = app.cached_items[i].y

@export(wasm, "get_item_w")
fn get_item_w(i: Int) -> Float = app.cached_items[i].w

@export(wasm, "get_item_h")
fn get_item_h(i: Int) -> Float = app.cached_items[i].h

@export(wasm, "get_item_kind")
fn get_item_kind(i: Int) -> Int = app.cached_items[i].kind

@export(wasm, "get_item_text")
fn get_item_text(i: Int) -> Int = s(app.cached_items[i].content)

@export(wasm, "get_item_font_size")
fn get_item_font_size(i: Int) -> Float = app.cached_items[i].font_size

@export(wasm, "get_item_selectable")
fn get_item_selectable(i: Int) -> Int = app.cached_items[i].selectable

@export(wasm, "get_item_scrollable")
fn get_item_scrollable(i: Int) -> Int = app.cached_items[i].scrollable

@export(wasm, "get_list_frame_y")
fn get_list_frame_y() -> Float = app.list_frame_y()

@export(wasm, "get_list_frame_h")
fn get_list_frame_h() -> Float = app.list_frame_height()

// ══════════════════════════════════════════════════════════════
// Click handling
// ══════════════════════════════════════════════════════════════

@export(wasm, "handle_click")
fn handle_click(click_x: Float, click_y: Float) -> Int = app.handle_click(click_x, click_y)

// ══════════════════════════════════════════════════════════════
// Hit test (for scroll regions)
// ══════════════════════════════════════════════════════════════

@export(wasm, "hit_test")
fn do_hit_test(x: Float, y: Float) -> Int = app.hit_test(x, y)
