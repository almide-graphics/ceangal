// ceangal app runtime — shared by the browser and native hosts
//
// Architecture:
//   State change (rare): app() → layout → upload items → GPU
//   Scroll (60fps): write scroll_y → GPU compute+render (NO tree ops)
//
// The browser host (mod.almd's wasm exports + host/runtime.js) and the native
// host (examples/native) drive the same functions here. What differs is only
// the host's half: the browser draws item text as DOM spans and edits the
// text field in a <textarea>; natively `text_layer` draws both through
// snaidhm's glyph cache, and `type_char` / `backspace` edit the field.

import self.scroll as sc
import self.todoapp as td
import self.render as render
import self.view as v
import snaidhm
import snaidhm.web.gpu as gpu
import snaidhm.text as text

// ══════════════════════════════════════════════════════════════
// State
// ══════════════════════════════════════════════════════════════

var cached_scene: snaidhm.SceneHandle = {
  device: 0, width: 0, height: 0, viewport_tiles_x: 0, viewport_tiles_y: 0,
  content_tiles_x: 0, content_tiles_y: 0,
  dispatch_tiles_x: 0, dispatch_tiles_y: 0,
  params_buf: 0, regions_buf: 0, pixel_buf: 0, items_buf: 0,
  tile_counts_buf: 0, tile_ids_buf: 0,
  compute_pipeline: 0, compute_bg: 0, compute_regions_bg: 0, compute_tile_bg: 0,
  quad_pipeline: 0, quad_bg: 0, quad_regions_bg: 0, quad_bg_tex: 0,
  img_pipeline: 0, img_bg: 0, img_vtx: 0, img_idx: 0, img_count: 0, format: 0,
}
var scene_ready = false
var viewport_w = 0.0
var viewport_h = 0.0
var root_region = 0
var cached_items: List[render.RenderItem] = []

// The text field's content as UTF-8.
var input_buf: List[Int] = []

// ══════════════════════════════════════════════════════════════
// Upload items (ONLY on state change — never during scroll)
// ══════════════════════════════════════════════════════════════

fn dpr() -> Float = int.to_float(cached_scene.height) / viewport_h

fn rebuild_and_upload() -> Unit = {
  let view = td.app()
  let items = render.render_at(view, viewport_w, viewport_h, 0.0)
  cached_items = items
  upload_visible()

  // Update scroll bounds
  let content_h = render.list_content_height(view)
  if render.list_frame_height > 0.0 then {
    sc.set_viewport_height(root_region, render.list_frame_height)
    if content_h > 0.0 then {
      sc.set_content_height(root_region, content_h)
    } else ()
    let s = dpr()
    let clip_top = render.list_frame_y * s
    let clip_bottom = (render.list_frame_y + render.list_frame_height) * s
    gpu.write_f32_at(cached_scene.device, cached_scene.params_buf, 20, clip_top)
    gpu.write_f32_at(cached_scene.device, cached_scene.params_buf, 24, clip_bottom)
    // Override content_tiles_y so root scrollbar knows actual content height
    let content_tiles = float.to_int(float.ceil(content_h * s / 16.0))
    gpu.write_u32_at(cached_scene.device, cached_scene.params_buf, 16, content_tiles)
  } else ()
}

// Upload only on-screen items to GPU (fast enough to call every scroll frame)
fn upload_visible() -> Unit = {
  let s = dpr()
  let ry = sc.ax(root_region, sc.AXIS_Y)
  let scroll_px = sc.ax_pos[ry] * s
  let screen_h = viewport_h * s
  var xs: List[Float] = []
  var ys: List[Float] = []
  var ws: List[Float] = []
  var hs: List[Float] = []
  var bg_rs: List[Float] = []
  var bg_gs: List[Float] = []
  var bg_bs: List[Float] = []
  var bg_as: List[Float] = []
  var roundeds: List[Float] = []
  var opacities: List[Float] = []
  var scrollables: List[Float] = []
  // Where each item is on screen: the shader draws a scrollable item at its
  // layout y plus the scroll offset, and looks it up in the tile of that
  // on-screen position — so tiles are assigned from this, not from `ys`.
  var screen_ys: List[Float] = []
  for item in cached_items {
    let iy = item.y * s + (if item.scrollable == 1 then scroll_px else 0.0)
    let visible = item.scrollable == 0 or (iy + item.h * s > 0.0 and iy < screen_h)
    if visible then {
      list.push(xs, item.x * s)
      list.push(ys, item.y * s)
      list.push(screen_ys, iy)
      list.push(ws, item.w * s)
      list.push(hs, item.h * s)
      list.push(bg_rs, item.bg_r)
      list.push(bg_gs, item.bg_g)
      list.push(bg_bs, item.bg_b)
      list.push(bg_as, item.bg_a)
      list.push(roundeds, item.rounded * s)
      list.push(opacities, item.opacity)
      list.push(scrollables, int.to_float(item.scrollable))
    } else ()
  }
  let gpu_count = list.len(xs)
  snaidhm.upload_items(cached_scene, gpu_count, xs, ys, ws, hs, bg_rs, bg_gs, bg_bs, bg_as, roundeds, opacities, scrollables)

  // Tile assignment for tile-based dispatch
  let dtx = cached_scene.dispatch_tiles_x
  let dty = cached_scene.dispatch_tiles_y
  let tile_count = dtx * dty
  var tile_counts: List[Int] = list.repeat(0, int.max(1, tile_count))
  var tile_ids: List[Int] = list.repeat(0, int.max(1, tile_count * 32))
  let tile_size_f = int.to_float(64)
  for i in 0..<gpu_count {
    let ix = xs[i]
    let iy = screen_ys[i]
    let iw = ws[i]
    let ih = hs[i]
    let tx0 = int.max(0, float.to_int(float.floor(ix / tile_size_f)))
    let ty0 = int.max(0, float.to_int(float.floor(iy / tile_size_f)))
    let tx1 = int.min(dtx - 1, float.to_int(float.floor((ix + iw) / tile_size_f)))
    let ty1 = int.min(dty - 1, float.to_int(float.floor((iy + ih) / tile_size_f)))
    for ty in ty0...ty1 {
      for tx in tx0...tx1 {
        let tid = ty * dtx + tx
        let c = tile_counts[tid]
        if c < 32 then {
          tile_ids[tid * 32 + c] = i
          tile_counts[tid] = c + 1
        } else ()
      }
    }
  }
  snaidhm.upload_tile_assignment(cached_scene, tile_counts, tile_ids)
}

// ══════════════════════════════════════════════════════════════
// Draw (scroll hot path — NO allocations, NO tree ops)
// ══════════════════════════════════════════════════════════════

fn draw() -> Unit = {
  if scene_ready then {
    let s = dpr()
    let ry = sc.ax(root_region, sc.AXIS_Y)
    snaidhm.draw_frame_2d(cached_scene,
      0.0, sc.ax_pos[ry] * s,
      sc.ax_bar_opacity[ry], 0.0, 0.0, 0.0)
  } else ()
}

/// `draw`, with `layer` (from `text_layer`) over the UI.
fn draw_with_text(layer: text.TextLayer) -> Unit = {
  if scene_ready then {
    let s = dpr()
    let ry = sc.ax(root_region, sc.AXIS_Y)
    snaidhm.draw_frame_2d_text(cached_scene, layer,
      0.0, sc.ax_pos[ry] * s,
      sc.ax_bar_opacity[ry], 0.0, 0.0, 0.0)
  } else ()
}

// ══════════════════════════════════════════════════════════════
// Mouse effects (fragment-only, no compute re-run)
// ══════════════════════════════════════════════════════════════

fn set_mouse(css_x: Float, css_y: Float) -> Unit = {
  if scene_ready then {
    let s = dpr()
    gpu.write_f32_at(cached_scene.device, cached_scene.params_buf, 56, css_x * s)
    gpu.write_f32_at(cached_scene.device, cached_scene.params_buf, 60, css_y * s)
  } else ()
}

fn draw_light() -> Unit = {
  if scene_ready then snaidhm.draw_render_only(cached_scene) else ()
}

fn set_hover(item_idx: Float) -> Unit = {
  if scene_ready then {
    gpu.write_f32_at(cached_scene.device, cached_scene.params_buf, 44, item_idx)
    snaidhm.draw_render_only(cached_scene)
  } else ()
}

// ══════════════════════════════════════════════════════════════
// Scene lifecycle
// ══════════════════════════════════════════════════════════════

type SceneData = {
  cubics: List[snaidhm.Cubic],
  paints: List[snaidhm.Paint],
  shadows: List[snaidhm.Shadow],
}

fn build_empty_scene() -> SceneData = {
  let shadows = [snaidhm.rect_shadow(99.0, 99.0, 0.01, 0.01, 0.0, 0.0, 0.0, 0.001, [0.0,0.0,0.0,0.0])]
  let paints = [snaidhm.solid(0.0, 0.0, 0.0, 0.0)]
  let cubics: List[snaidhm.Cubic] = []
  { cubics: cubics, paints: paints, shadows: shadows }
}

/// (Re)build the scene for a `css_w` x `css_h` viewport drawn at
/// `phys_w` x `phys_h` pixels (multiples of 16).
fn prepare(device: Int, css_w: Int, css_h: Int, phys_w: Int, phys_h: Int,
           img_vtx: Int, img_idx: Int, img_count: Int, img_texture: Int, img_sampler: Int,
           bg_texture: Int, bg_sampler: Int) -> Unit = {
  viewport_w = int.to_float(css_w)
  viewport_h = int.to_float(css_h)

  let data = build_empty_scene()
  cached_scene = snaidhm.prepare_scene(device, phys_w, phys_h, phys_w, phys_h,
    data.cubics, data.shadows, data.paints,
    img_vtx, img_idx, img_count, img_texture, img_sampler,
    bg_texture, bg_sampler)
  scene_ready = true

  // Init scroll
  sc.reset_all()
  root_region = sc.create_region(viewport_w, viewport_h, viewport_w, viewport_h, 0 - 1)

  draw()
}

// ══════════════════════════════════════════════════════════════
// Scroll (hot path — physics only)
// ══════════════════════════════════════════════════════════════

/// Advance scroll physics by `dt` seconds and re-upload what moved, without
/// drawing — for a host that draws the frame itself. 1 while still animating.
fn scroll_step(dt: Float) -> Int = {
  let running = sc.tick_all(dt)
  upload_visible()
  running
}

/// `scroll_step`, then draw.
fn scroll_tick(dt: Float) -> Int = {
  let running = scroll_step(dt)
  draw()
  running
}

fn scroll_wheel(region: Int, dx: Float, dy: Float) -> Unit =
  sc.route_wheel(region, dx, dy)

fn get_scroll_pos(region: Int, axis: Int) -> Float = sc.get_pos(region, axis)

fn flush() -> Unit = {
  rebuild_and_upload()
  draw()
}

fn set_scroll_frac(frac: Float) -> Unit = {
  let ry = sc.ax(root_region, sc.AXIS_Y)
  sc.set_scrollbar_frac(ry, frac, sc.rgn_content_h[root_region], sc.rgn_bounds_h[root_region])
}

fn get_scroll_info() -> Float = {
  // Returns content_h * 1000 + viewport_h (packed for simplicity)
  sc.rgn_content_h[root_region] * 10000.0 + sc.rgn_bounds_h[root_region]
}

fn set_viewport(w: Float, h: Float) -> Unit = {
  viewport_w = w
  viewport_h = h
}

// ══════════════════════════════════════════════════════════════
// Text field input
// ══════════════════════════════════════════════════════════════

fn input_clear() -> Unit = { input_buf = [] }

fn input_push(byte: Int) -> Unit = { input_buf = input_buf + [byte] }

/// Add the field's text (trimmed) as a todo and empty the field.
fn input_submit() -> Unit = {
  let entered = string.trim(string.from_bytes(input_buf))
  input_buf = []
  if string.len(entered) > 0 then {
    td.add_todo(entered)
    rebuild_and_upload()
    draw()
  } else ()
}

/// Type code point `code` into the field.
fn type_char(code: Int) -> Unit = {
  input_buf = input_buf + string.to_bytes(string.from_codepoint(code))
}

/// Delete the field's last character: its trailing continuation bytes
/// (10xxxxxx) and the byte that leads them.
fn backspace() -> Unit = {
  var n = list.len(input_buf)
  while n > 0 and input_buf[n - 1] >= 0x80 and input_buf[n - 1] < 0xC0 {
    n = n - 1
  }
  input_buf = list.take(input_buf, int.max(0, n - 1))
}

// ══════════════════════════════════════════════════════════════
// State change (triggers rebuild)
// ══════════════════════════════════════════════════════════════

fn todo_init_data() -> Unit = {
  for i in 0..<20 {
    td.add_todo("Item " + int.to_string(i))
  }
  rebuild_and_upload()
  draw()
}

fn todo_add() -> Unit = {
  let idx = td.next_id.get()
  td.add_todo("Item " + int.to_string(idx))
  rebuild_and_upload()
  draw()
}

fn todo_toggle(id: Int) -> Unit = {
  td.toggle_todo(id)
  rebuild_and_upload()
  draw()
}

// ══════════════════════════════════════════════════════════════
// Click handling
// ══════════════════════════════════════════════════════════════

/// What a click at (`click_x`, `click_y`) hits: -2 the add button, a todo id,
/// or -1 nothing.
fn handle_click(click_x: Float, click_y: Float) -> Int = {
  let list_y = render.list_frame_y
  let list_h = render.list_frame_height

  // Button first (below list)
  if click_y > list_y + list_h then 0 - 2
  // List area
  else if click_y >= list_y then {
    let scroll_y = sc.get_pos(root_region, sc.AXIS_Y)
    let ih = 56.0
    let todos_list = td.todos.get()
    let total = list.len(todos_list)
    let content_y = click_y - scroll_y - list_y
    let idx = float.to_int(float.floor(content_y / ih))
    if idx >= 0 and idx < total then todos_list[idx].id
    else 0 - 1
  }
  else 0 - 1
}

/// A click, acted on: add a todo or toggle one, as the browser host does.
fn click(x: Float, y: Float) -> Unit = {
  let hit = handle_click(x, y)
  if hit == 0 - 2 then todo_add()
  else if hit >= 0 then todo_toggle(hit)
  else ()
}

fn hit_test(x: Float, y: Float) -> Int = sc.full_hit_test(x, y)

/// The list's frame, CSS pixels: where scrolled rows are visible.
fn list_frame_y() -> Float = render.list_frame_y

fn list_frame_height() -> Float = render.list_frame_height

// ══════════════════════════════════════════════════════════════
// Text, drawn through snaidhm's glyph cache (native host)
// ══════════════════════════════════════════════════════════════

/// The code points of `s`, as a text run takes them.
fn code_points(s: String) -> List[Int] = {
  let cs = string.chars(s)
  let n = list.len(cs)
  var out: List[Int] = []
  for i in 0..<n { list.push(out, string.codepoint(cs[i]) ?? 0) }
  out
}

/// `layer` holding the UI's text: every TEXT item as the browser's DOM
/// overlay places it — left in its box, centred on the line, cut to the box,
/// and list rows also to the list's frame as they scroll — and the text
/// field's content (or its placeholder) inset 12px as its <textarea> is.
fn text_layer(device: Int, layer: text.TextLayer) -> text.TextLayer = {
  let s = dpr()
  let scroll_px = sc.ax_pos[sc.ax(root_region, sc.AXIS_Y)] * s
  let frame_top = render.list_frame_y * s
  let frame_bottom = (render.list_frame_y + render.list_frame_height) * s
  var l = text.clear(layer)
  let n = list.len(cached_items)
  for i in 0..<n {
    let item = cached_items[i]
    let size = item.font_size * s
    let x = item.x * s
    let w = item.w * s
    let h = item.h * s
    let y = item.y * s + (if item.scrollable == 1 then scroll_px else 0.0)
    // The theme's colour where it sets one; the DOM overlay's white otherwise.
    let lit = item.fg_a > 0.0
    let r = if lit then item.fg_r else 1.0
    let g = if lit then item.fg_g else 1.0
    let b = if lit then item.fg_b else 1.0
    let a = if lit then item.fg_a else 1.0
    if item.kind == v.TEXT and string.len(item.content) > 0 then {
      let baseline = y + h / 2.0 + (text.ascent(l, size) - text.descent(l, size)) / 2.0
      let top = if item.scrollable == 1 then float.max(y, frame_top) else y
      let bottom = if item.scrollable == 1 then float.min(y + h, frame_bottom) else y + h
      l = text.add_run(device, l, code_points(item.content), size, x, baseline,
        r, g, b, a, x, top, x + w, bottom)
    } else if item.kind == v.TEXT_FIELD then {
      let pad = 12.0 * s
      let empty = list.len(input_buf) == 0
      let shown = code_points(if empty then item.content else string.from_bytes(input_buf))
      let dim = if empty then 0.5 else 1.0
      let baseline = y + pad + text.ascent(l, size)
      l = text.add_run(device, l, shown, size, x + pad, baseline,
        dim, dim, dim, 1.0, x, y, x + w, y + h)
    } else ()
  }
  text.upload(device, l, cached_scene.width, cached_scene.height)
}
