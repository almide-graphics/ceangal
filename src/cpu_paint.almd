// ceangal cpu_paint — the todo app (ui.almd) on snaidhm's CPU canvas
//
// cpu_draw's items with ui's text field and scroll, on a dark page, and the
// list's scrollbar, which the GPU host's shader draws.

import self.cpu_draw as draw
import self.ui as ui
import snaidhm.cpu.canvas as canvas
import snaidhm.sfnt as sfnt

/// The page behind the items.
let BACKGROUND = 0.06

/// ui's items on `frame` (a canvas for the window, drawn on in CSS pixels):
/// the todo app, its field, list and scrollbar.
fn paint(frame: canvas.Canvas, fonts: List[sfnt.Font]) -> canvas.Canvas = {
  let field = { typed: ui.typed(), compose: ui.compose, from: ui.compose_from, to: ui.compose_to }
  let top = ui.list_frame_y()
  let scroll = { offset: ui.scroll_y(), top: top, bottom: top + ui.list_frame_height() }
  let p = draw.draw(canvas.clear(frame, BACKGROUND, BACKGROUND, BACKGROUND), fonts, ui.items, field, scroll)
  ui.set_caret(p.caret_x, p.caret_y, p.caret_h)
  scrollbar(p.canvas)
}

/// The list's scrollbar: a thumb at the right edge of its frame while it
/// scrolls, fading out once it stops.
fn scrollbar(frame: canvas.Canvas) -> canvas.Canvas = {
  let thumb = ui.scrollbar_thumb()
  let a = ui.scrollbar_opacity()
  if thumb.1 > thumb.0 and a > 0.0 then {
    let right = ui.viewport_w - 3.0
    canvas.rect(frame, right - 5.0, thumb.0, right, thumb.1, 2.5, 1.0, 1.0, 1.0, 0.45 * a)
  } else frame
}
